class SimpleCardGame is ArcanaGame {
    cards: SimpleDeck;
    table: SimpleTable;

    constructor(players: Player) {
        super();
    }

    @override
    init: Function<void> = () {
        @eternal
        allCards: string[] = ["Cartita1", "Cartita2"];
        
        this.cards = SimpleDeck(allCards);
        this.table = SimpleTable(this.cards, this.players);
    };

    @hidden
    _generateNumberCards:  Function<SimpleCard> = (){
        @eternal
        colors: string[] = ["red", "blue"];
        
        @eternal
        cards: int[] = [];
        MAX_CARDS: int = 6;
        for (color: colors) {
            # Una carta de cada número (1-3) por color
            for (num:MAX_CARDS) {
                #cards.add(SimpleCard("${color}_${num}", null, color, num, PlayCardAction()));
            }
        }
        
        return cards;
    };
}
