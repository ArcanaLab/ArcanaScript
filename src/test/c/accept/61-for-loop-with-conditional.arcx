class ForLoopWithConditionalTest {
    @exposed numbers: int[] = [1, 2, 3, 4, 5];
    for(num : numbers) {
        if ((num / 2) == 0) {
         print("Even: " + num);
         result:int = (num * 2);
        } else {
         print("Odd: " + num);
         result:int = (num * 3);
        }
    }
    result:int = 0;
}
