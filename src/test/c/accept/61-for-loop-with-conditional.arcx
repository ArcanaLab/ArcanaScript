@exposed
class ForLoopWithConditionalTest {
    result : Function<void> = () {
        numbers: List<int> = [1, 2, 3, 4, 5];
        result: int = 0;
        for(num : numbers) {
            if ((num % 2) == 0) {
                print("Even: ");
                result = (num * 2);
            } else {
                print("Odd: ");
                result = (num * 3);
            }
        }
    };
}
