class DrawCardAction using ArcanaAction {
    @exposed
    dispatch: Function<void> = () {
        #! Roba una carta del mazo !#
        print("YAY!"); 
    };
}

class PlayCardAction using ArcanaAction {
    @exposed
    dispatch: Function<void> = () {
        #! Juega una carta !#
        print("YAY!");
    };  
}

class DrawTwoAction using ArcanaAction {
    @exposed
    dispatch: Function<void> = () {
        #! El siguiente jugador roba dos cartas y pierde su turno !#
        print("YAY!");
    };
}

class ReverseAction using ArcanaAction {
    @exposed
    dispatch: Function<void> = () {
        #! Invierte la dirección del juego !#
        print("YAY!");
    };
}

class SkipAction using ArcanaAction {
    @exposed
    dispatch: Function<void> = () {
        #! El siguiente jugador pierde su turno !#
        print("YAY!");
    };
}
 class WildAction using ArcanaAction {
    @exposed
    dispatch: Function<void> = () {
        #! Permite al jugador cambiar el color en juego !#
        print("YAY!");
    };
}
 class WildDrawFourAction using ArcanaAction {
    @exposed
    dispatch: Function<void> = () {
        #! El jugador elige el color y el siguiente roba cuatro cartas y pierde su turno !#
        print("YAY!");
    };
}